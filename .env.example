# AIRAVAT environment template. Copy to .env.local. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
# Server-only secrets (never NEXT_PUBLIC_)
ANTHROPIC_API_KEY=
SARVAM_API_KEY=
# sandbox | live  (live is not permitted until regulatory and exchange gates are satisfied)
AIRAVAT_ENV=sandbox
# Shared secret for the scheduled simulated-market tick endpoint
SIM_TICK_SECRET=
